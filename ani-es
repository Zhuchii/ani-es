#!/bin/bash

VERSION="1.4.1"

CONTINUE=0
progress="00:00:00"

# cosas para texto
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'

# cosas para el fondo del texto
BG_RED='\033[41m'
BG_GREEN='\033[42m'
BG_YELLOW='\033[43m'
BG_BLUE='\033[44m'
BG_PURPLE='\033[45m'
BG_CYAN='\033[46m'
BG_WHITE='\033[47m'


NC='\033[0m'

HISTORY_DIR="$HOME/ani-es"
OLD_DB="$HISTORY_DIR/history.db"
HISTORY_FILE="$HOME/ani-es/history.json"


init_history() {

    mkdir -p "$HISTORY_DIR"

    [[ -f "$HISTORY_FILE" ]] || echo "{}" > "$HISTORY_FILE"

    if [[ -f "$OLD_DB" ]]; then

        echo
        echo "El sistema de guardado de historial ha cambiado."
        read -rp "¿Desea importar su antiguo historial? (y/n): " respuesta

        if [[ "$respuesta" =~ ^[YySs]$ ]]; then

            echo "Importando historial..."

            if python3 <<EOF
import sqlite3
import json

db_path = "$OLD_DB"
json_path = "$HISTORY_FILE"

try:
    with open(json_path, "r", encoding="utf-8") as f:
        history = json.load(f)
except:
    history = {}

conn = sqlite3.connect(db_path)
cursor = conn.cursor()

cursor.execute("""
SELECT name
FROM sqlite_master
WHERE type='table' AND name='animes'
""")

if cursor.fetchone():

    cursor.execute("SELECT anime,last_cap,progress FROM animes")

    for anime,last_cap,progress in cursor.fetchall():

        try:
            last_cap = int(last_cap)
        except (TypeError, ValueError):
            last_cap = 0

        if not progress:
            progress = "00:00:00"

        history[anime] = {
            "last_cap": last_cap,
            "progress": progress
        }

conn.close()

with open(json_path, "w", encoding="utf-8") as f:
    json.dump(history, f, indent=4, ensure_ascii=False)

EOF
            then
                rm -f "$OLD_DB"
                echo "Historial importado correctamente."
            else
                echo "Ha ocurrido un error durante la importación."
                echo "La base de datos antigua no se ha eliminado."
            fi

        else
            rm -f "$OLD_DB"
            echo "El historial antiguo ha sido eliminado."
        fi
    fi
}

init_history

clear
get_last_cap() {
    jq -r --arg anime "$1" \
        '.[$anime].last_cap // ""' \
        "$HISTORY_FILE"
}


get_progress() {
    jq -r --arg anime "$1" \
        '(.[$anime].progress // "") | if . == "" then "00:00:00" else . end' \
        "$HISTORY_FILE"
}


save_history() {
    local anime="$1"
    local cap="$2"
    local progress="$3"

    tmp=$(mktemp)

    jq \
        --arg anime "$anime" \
        --arg cap "$cap" \
        --arg progress "$progress" \
        '.[$anime] = {
            last_cap: ($cap|tonumber),
            progress: $progress
        }' \
        "$HISTORY_FILE" > "$tmp"

    mv "$tmp" "$HISTORY_FILE"
}
 

show_help() {
    echo ""
    echo "    Uso: ani-es [opciones] [busqueda]"
    echo ""
    echo "    Opciones:"
    echo "      -h, --help       Mostrar ayuda"
    echo "      -v, --version    Mostrar versión"
    echo "      -c, --continue   Continua el anime en donde ultimo lo dejaste"
    echo ""
}

show_version() {
    echo -e "ani-es ${PURPLE}v${VERSION}${NC}"
}

# parseo de argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -c|--continue)
            CONTINUE=1
            ;;
        *)
            break
            ;;
    esac
    shift
done


arg1="$*"


check_dependencies() {
    local script_name
    script_name=$(basename "$0")
    local missing=()

    for cmd in "$@"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${CYAN}[$script_name]${RED} Dependencias faltantes:${NC}"
        for pkg in "${missing[@]}"; do
            echo -e "${CYAN}  - $pkg ${NC}"
        done
        echo -e "${GREEN}Ejecuta el instalador antes de usar este script.${NC}"
        exit 1
    fi
}

detect_env() {
    # WSL (1 o 2)
    if grep -qi microsoft /proc/version 2>/dev/null || [ -n "$WSL_DISTRO_NAME" ]; then
        echo "wsl"
    # Termux (Android)
    elif [ -n "$PREFIX" ] && [[ "$PREFIX" == *com.termux* ]]; then
        echo "termux"
    # Linux normal
    else
        echo "linux"
    fi
}

main() {

