NC='\033[0m'


show_help() {
    echo ""
    echo "    Uso: ani-es [opciones] [busqueda]"
    echo ""
    echo "    Opciones:"
    echo "      -h, --help       Mostrar ayuda"
    echo "      -v, --version    Mostrar versión"
    echo "      -c, --continue   Continua el anime en donde ultimo lo dejaste"
    echo "      -f, --favorites  Muestra tu lista de animes favoritos"
    echo "      -p, --popular    Muestra los mas populares de la temporada actual"
    echo "      -r, --random     Muestra 10 animes al azar para descubrir"
    echo ""
}

show_version() {
    echo -e "ani-es ${PURPLE}v${VERSION}${NC}"
}

# parseo de argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -c|--continue)
            CONTINUE=1
            ;;
        -f|--favorites)
            FAVORITES=1
            ;;
        -p|--popular)
            POPULAR=1
            ;;
        -r|--random)
            ALEATORIO=1
            ;;
        *)
            break
            ;;
    esac
    shift
done


arg1="$*"


check_dependencies() {
    local script_name
    script_name=$(basename "$0")
    local missing=()

    for cmd in "$@"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${CYAN}[$script_name]${RED} Dependencias faltantes:${NC}"
        for pkg in "${missing[@]}"; do
            echo -e "${CYAN}  - $pkg ${NC}"
        done
        echo -e "${GREEN}Ejecuta el instalador antes de usar este script.${NC}"
        exit 1
    fi
}

detect_env() {
    # WSL (1 o 2)
    if grep -qi microsoft /proc/version 2>/dev/null || [ -n "$WSL_DISTRO_NAME" ]; then
        echo "wsl"
    # Termux (Android)
    elif [ -n "$PREFIX" ] && [[ "$PREFIX" == *com.termux* ]]; then
        echo "termux"
    # Linux normal
    else
        echo "linux"
    fi
}

# Acceso centralizado a la base de datos de historial/favoritos.
# Uso: db <accion>  ->  get_last_cap | get_progress | save | set_last_cap
#                       favorite | unfavorite | is_favorite | list_favorites
# Los valores se pasan por entorno (no se interpolan en SQL) para evitar
# romper con titulos que contengan comillas o apostrofes.
db() {
    ANIES_ANIME="$titulo_elegido" ANIES_CAPI="$capi" ANIES_PROGRESS="${pos:-$progress}" python3 - "$1" <<'PYEOF'
import sqlite3
import os
import sys

action = sys.argv[1] if len(sys.argv) > 1 else ""
anime = os.environ.get("ANIES_ANIME", "")
capi = os.environ.get("ANIES_CAPI", "")
progress = os.environ.get("ANIES_PROGRESS", "")


def to_int(value):
    try:
        return int(value)
    except (TypeError, ValueError):
        return -1


def conection():
    home_dir = os.path.expanduser("~")
    db_path = os.path.join(home_dir, "ani-es", "history.db")
    return sqlite3.connect(db_path)


conect = conection()
cursor = conect.cursor()

# Crear tabla si no existe y asegurar columnas
cursor.execute("SELECT count(name) FROM sqlite_master WHERE type='table' AND name='animes'")
if cursor.fetchone()[0] == 0:
    cursor.execute(
        "CREATE TABLE animes (id INTEGER PRIMARY KEY, anime TEXT, last_cap TEXT, progress TEXT)"
    )
    conect.commit()

cursor.execute("PRAGMA table_info(animes)")
columns = [col[1] for col in cursor.fetchall()]
if "progress" not in columns:
    cursor.execute("ALTER TABLE animes ADD COLUMN progress TEXT DEFAULT 0")
    conect.commit()
if "favorite" not in columns:
    cursor.execute("ALTER TABLE animes ADD COLUMN favorite INTEGER DEFAULT 0")
    conect.commit()

if action == "get_last_cap":
    cursor.execute("SELECT last_cap FROM animes WHERE anime = ?", (anime,))
    row = cursor.fetchone()
    if row:
        print(row[0])

elif action == "get_progress":
    cursor.execute("SELECT progress FROM animes WHERE anime = ?", (anime,))
    row = cursor.fetchone()
    if row and row[0] is not None:
        print(row[0])

elif action == "save":
    cursor.execute("SELECT * FROM animes WHERE anime = ?", (anime,))
    row = cursor.fetchone()
    if row is None:
        cursor.execute(
            "INSERT INTO animes (anime, last_cap, progress) VALUES (?, ?, ?)",
            (anime, capi, progress),
        )
    elif to_int(row[2]) < to_int(capi):
        cursor.execute(
            "UPDATE animes SET last_cap = ?, progress = ? WHERE anime = ?",
            (capi, progress, anime),
        )
    else:
        cursor.execute(
            "UPDATE animes SET progress = ? WHERE anime = ?",
            (progress, anime),
        )
    conect.commit()

elif action == "set_last_cap":
    cursor.execute("SELECT * FROM animes WHERE anime = ?", (anime,))
    row = cursor.fetchone()
    if row is None:
        cursor.execute(
            "INSERT INTO animes (anime, last_cap) VALUES (?, ?)", (anime, capi)
        )
    elif to_int(row[2]) < to_int(capi):
        cursor.execute(
            "UPDATE animes SET last_cap = ? WHERE anime = ?", (capi, anime)
        )
    conect.commit()

elif action == "favorite":
    cursor.execute("UPDATE animes SET favorite = 1 WHERE anime = ?", (anime,))
    conect.commit()

elif action == "unfavorite":
    cursor.execute("UPDATE animes SET favorite = 0 WHERE anime = ?", (anime,))
    conect.commit()

elif action == "is_favorite":
    cursor.execute("SELECT favorite FROM animes WHERE anime = ?", (anime,))
    row = cursor.fetchone()
    if row and row[0] == 1:
        print("1")

elif action == "list_favorites":
    cursor.execute(
        "SELECT anime, last_cap FROM animes WHERE favorite = 1 ORDER BY anime"
    )
    for a, lc in cursor.fetchall():
        print(f"{a}\tUltimo episodio: {lc}")

conect.close()
PYEOF
}

